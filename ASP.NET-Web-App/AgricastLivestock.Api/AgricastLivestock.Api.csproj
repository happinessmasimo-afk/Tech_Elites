<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgricastLivestock.Api</RootNamespace>
    <!-- Lets the app start even if the exact 9.x patch isn't installed but
         a newer major version (e.g. 10.x) is — matches your machine, which
         has 9.0.4 and 10.0.12 but no 8.x. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
