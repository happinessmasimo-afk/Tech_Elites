# Copy to appsettings.Development.json values, or set as environment
# variables (ASP.NET reads Supabase__Url / Supabase__AnonKey from env too).
#
# Find these in the Supabase dashboard: Project Settings -> API
#   Project URL          -> Supabase__Url
#   anon / public API key -> Supabase__AnonKey
#
# The service role key is NOT used by this API on purpose: every request is
# made using the end user's own access token, so Postgres row-level security
# (from supabase/migrations) is what actually enforces who can see/write what.
Supabase__Url=https://YOUR-PROJECT-REF.supabase.co
Supabase__AnonKey=YOUR-ANON-PUBLIC-KEY
